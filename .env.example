# Django core. Generate SECRET_KEY with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False
SECRET_KEY=replace-with-a-generated-secret-of-at-least-50-characters
ALLOWED_HOSTS=sacco.example.org
CORS_ALLOWED_ORIGINS=https://sacco.example.org
CSRF_TRUSTED_ORIGINS=https://sacco.example.org

# Database (PostgreSQL recommended for a multi-user deployment)
USE_POSTGRES=1
DB_NAME=sacco
DB_USER=sacco_app
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Email (required for email OTP and account notifications)
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@example.org
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=notifications@example.org

# SMS via Africa's Talking (needed for SMS OTP and alerts)
AT_USERNAME=replace-me
AT_API_KEY=replace-me

# Credit Reference Bureau: stub is for development and reports no decision.
CRB_PROVIDER=stub
CRB_API_KEY=
CRB_API_URL=
CRB_FLAG_SCORE_THRESHOLD=500

# Safaricom Daraja M-Pesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=https://sacco.example.org
# URL-safe secret for the registered C2B confirmation URL in production.
TRANSPORT_C2B_CALLBACK_TOKEN=
MPESA_REGISTRATION_FEE=500

# Optional ID verification providers
SMILE_IDENTITY_API_KEY=
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_ENV=sandbox
SMILE_IDENTITY_API_URL=https://testapi.smileidentity.com/v1/id_verification
FACE_MATCH_THRESHOLD=70
NAME_MATCH_THRESHOLD=75
ID_DOC_MAX_MB=5

# KYC workflow & data protection (Kenya DPA 2019)
# How long raw ID/selfie documents are retained before purging (days).
KYC_DOCUMENT_RETENTION_DAYS=730
# Composite risk-score thresholds (0-100): >=auto-approve auto-activates,
# 50-79 needs staff review, <50 is rejected by the engine.
KYC_AUTO_APPROVE_THRESHOLD=80
KYC_REJECT_THRESHOLD=50
